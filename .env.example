# AI Service Server Configuration
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0

# TimescaleDB / PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=LocalSecretPass!23
DB_NAME=shrimp_local_db

# Redis Caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL=1800

# RabbitMQ AMQP Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASS=admin123
RABBITMQ_EXCHANGE=shrimp.events
RABBITMQ_QUEUE=ai_risk_alerts

# Core Backend URL (for callbacks or references)
CORE_BACKEND_URL=http://localhost:3000
